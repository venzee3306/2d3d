INTERNAL_API_KEY=shared-internal-api-key-change-in-production
PORT=8001
DEFAULT_AGENT_ID=
CALLBACK_RETRY_ATTEMPTS=3
PUBLIC_API_KEY=your-public-api-key-for-external-platforms
