# Agent Dashboard Backend
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_db
SECRET_KEY=your-secret-key-change-in-production
USER_BACKEND_URL=http://localhost:8001
# 2D live data from 2DBoss; optional, default https://luke.2dboss.com/api/luke/twod-result-live
